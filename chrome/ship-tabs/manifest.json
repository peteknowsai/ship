{
  "manifest_version": 3,
  "name": "Ship tabs",
  "version": "2.0",
  "description": "Files every page /ship opens into its app's tab group, labeled, without taking your tab; a redo replaces the old tab.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*.localhost/*",
    "https://*.vercel.app/*",
    "file:///*"
  ]
}
